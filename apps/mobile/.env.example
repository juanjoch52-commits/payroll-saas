# MyJova mobile app — copia a .env y rellena.
# Mismos valores de Supabase que la web (proyecto compartido).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# URL del backend MyJova (API REST /api/v1). En dev local: http://TU_IP_LAN:3000
EXPO_PUBLIC_API_URL=https://myjova.com
