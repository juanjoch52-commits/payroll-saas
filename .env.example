# =============================================================================
# MyJova — Environment variables
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commits .env.local al repositorio.
# =============================================================================

# --- Supabase --- [REQUIRED]
# Obtén estos valores en: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOLO uso en server (API routes / Server Actions / Server Components).
# NUNCA exponer al cliente. Bypasa RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --- [REQUIRED]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe --- [REQUIRED para billing]
# Obtén las keys en: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Webhook secret: se genera al crear el endpoint en Stripe Dashboard
# o con `stripe listen` en desarrollo.
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Price IDs — modelo base + por-trabajador-activo (DOS precios por tier).
# En cada producto crea 2 precios recurrentes mensuales:
#   _BASE = precio fijo mensual (flat)
#   _SEAT = precio por unidad (licensed per-unit; la app sincroniza la cantidad
#           con los trabajadores activos)
# Placeholders actuales (ajustables): Esencial $29+$5 · Avanzado $59+$7 · Premium $99+$10
STRIPE_PRICE_ESSENTIAL_BASE=price_
STRIPE_PRICE_ESSENTIAL_SEAT=price_
STRIPE_PRICE_ADVANCED_BASE=price_
STRIPE_PRICE_ADVANCED_SEAT=price_
STRIPE_PRICE_PREMIUM_BASE=price_
STRIPE_PRICE_PREMIUM_SEAT=price_

# --- Mapbox --- [REQUIRED para mapas]
# Crear cuenta gratis en: https://account.mapbox.com/access-tokens/
# Plan gratis hasta 50.000 loads/mes. El token público empieza con `pk.`
NEXT_PUBLIC_MAPBOX_TOKEN=pk.

# --- Resend (email transaccional) --- [REQUIRED para notificaciones email]
# Registrarse en: https://resend.com/api-keys
# Free: 100 emails/día, 3k/mes. $20/mes para 50k.
# Verifica el dominio myjova.com en https://resend.com/domains antes de producción.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@myjova.com

# --- Twilio (SMS) --- [OPTIONAL — sin esto SMS solo se loguea]
# Console: https://console.twilio.com
# Crear cuenta trial gratis. Necesitas verificar/comprar un número.
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1

# --- Web Push (VAPID) --- [OPTIONAL — sin esto push no funciona]
# Generar con: `npx web-push generate-vapid-keys`
# Copiar `publicKey` a NEXT_PUBLIC_VAPID_PUBLIC_KEY y `privateKey` a VAPID_PRIVATE_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@myjova.com

# --- Track1099 (e-filing 1099-NEC) --- [OPTIONAL — sin esto e-filing es stub]
# Registrarse en: https://www.track1099.com
TRACK1099_API_KEY=

# --- IRS FIRE (producción 1099/W-2 e-filing) --- [OPTIONAL para producción]
# Solo necesario para envío directo a IRS (alternativa: usar Track1099 arriba)
# Aplicar para TCC en: https://www.irs.gov/e-file-providers/filing-information-returns-electronically-fire
IRS_FIRE_TCC=
IRS_FIRE_PIN=

# --- Encryption (secretos en reposo) --- [REQUIRED para QuickBooks]
# Cifra los tokens OAuth de QuickBooks en la base de datos (AES-256-GCM).
# Genera una clave de 32 bytes con:  openssl rand -base64 32
# Sin esto, la conexión con QuickBooks se deshabilita con un mensaje (modo stub).
ENCRYPTION_KEY=

# --- QuickBooks Online --- [OPTIONAL — sin esto, sync en modo stub + export IIF/CSV]
# Crear una app en: https://developer.intuit.com/app/developer/dashboard
# Usa el entorno `sandbox` para pruebas y `production` para real.
# Redirect URI a registrar: <NEXT_PUBLIC_APP_URL>/api/integrations/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Token de verificación de webhooks (Intuit Dashboard → Webhooks).
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# --- MyRavex (FSM) --- [OPTIONAL — el webhook entrante está fail-closed sin esto]
# Secret compartido para validar HMAC-SHA256 de /api/webhooks/myravex.
MYRAVEX_WEBHOOK_SECRET=

# --- Square POS --- [OPTIONAL — sin esto, las propinas funcionan manual]
# App en: https://developer.squareup.com/apps  (usa sandbox primero)
# Redirect URL: <NEXT_PUBLIC_APP_URL>/api/integrations/square/callback
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENVIRONMENT=sandbox

# --- Expo Push (notificaciones de la app móvil) --- [OPTIONAL]
# El envío vía Expo Push API no requiere key, pero un access token sube los límites.
# Generar en: https://expo.dev/accounts/<cuenta>/settings/access-tokens
EXPO_ACCESS_TOKEN=
