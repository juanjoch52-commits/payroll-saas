# =============================================================================
# MyJova — Environment variables
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commits .env.local al repositorio.
# =============================================================================

# --- Supabase --- [REQUIRED]
# Obtén estos valores en: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOLO uso en server (API routes / Server Actions / Server Components).
# NUNCA exponer al cliente. Bypasa RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --- [REQUIRED]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe --- [REQUIRED para billing]
# Obtén las keys en: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Webhook secret: se genera al crear el endpoint en Stripe Dashboard
# o con `stripe listen` en desarrollo.
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Price IDs (uno por tier). Crea los productos en Stripe Dashboard,
# luego copia los Price IDs aquí.
STRIPE_PRICE_ESSENTIAL=price_
STRIPE_PRICE_ADVANCED=price_
STRIPE_PRICE_PREMIUM=price_

# --- Mapbox --- [REQUIRED para mapas]
# Crear cuenta gratis en: https://account.mapbox.com/access-tokens/
# Plan gratis hasta 50.000 loads/mes. El token público empieza con `pk.`
NEXT_PUBLIC_MAPBOX_TOKEN=pk.

# --- Resend (email transaccional) --- [REQUIRED para notificaciones email]
# Registrarse en: https://resend.com/api-keys
# Free: 100 emails/día, 3k/mes. $20/mes para 50k.
# Verifica el dominio myjova.com en https://resend.com/domains antes de producción.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@myjova.com

# --- Twilio (SMS) --- [OPTIONAL — sin esto SMS solo se loguea]
# Console: https://console.twilio.com
# Crear cuenta trial gratis. Necesitas verificar/comprar un número.
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1

# --- Web Push (VAPID) --- [OPTIONAL — sin esto push no funciona]
# Generar con: `npx web-push generate-vapid-keys`
# Copiar `publicKey` a NEXT_PUBLIC_VAPID_PUBLIC_KEY y `privateKey` a VAPID_PRIVATE_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@myjova.com

# --- Track1099 (e-filing 1099-NEC) --- [OPTIONAL — sin esto e-filing es stub]
# Registrarse en: https://www.track1099.com
TRACK1099_API_KEY=

# --- IRS FIRE (producción 1099/W-2 e-filing) --- [OPTIONAL para producción]
# Solo necesario para envío directo a IRS (alternativa: usar Track1099 arriba)
# Aplicar para TCC en: https://www.irs.gov/e-file-providers/filing-information-returns-electronically-fire
IRS_FIRE_TCC=
IRS_FIRE_PIN=
